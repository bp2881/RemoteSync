# Copy this file to .env and fill in real values.
# .env should NEVER be committed to version control.

REMOTE_SYNC_URL=http://[IP_ADDRESS]
REMOTE_SYNC_USERNAME=[USERNAME]
REMOTE_SYNC_PASSWORD=[PASSWORD]

# Optional overrides used by main.py's example workflow:
REMOTE_SYNC_VOLUME_ID=[VOLUME_ID]
REMOTE_SYNC_TEST_FILE=[TEST_FILE]

# Folder sync settings (used by main_sync.py):
REMOTE_SYNC_SYNC_REMOTE_PATH=[PATH_TO_YOUR_FOLDER_IN_ROUTER_METHOD]
REMOTE_SYNC_SYNC_LOCAL_PATH=[LOCAL_PATH]
REMOTE_SYNC_SYNC_DRY_RUN=false
